{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pramaan-api-shubhidixit09.vercel.app/api/:path*"
    },
    {
      "source": "/cases/new",
      "destination": "/index.html"
    },
    {
      "source": "/workspace",
      "destination": "/index.html"
    },
    {
      "source": "/workspace/:caseId",
      "destination": "/index.html"
    },
    {
      "source": "/research",
      "destination": "/index.html"
    },
    {
      "source": "/procedures",
      "destination": "/index.html"
    },
    {
      "source": "/drafts",
      "destination": "/index.html"
    },
    {
      "source": "/trust",
      "destination": "/index.html"
    }
  ]
}
