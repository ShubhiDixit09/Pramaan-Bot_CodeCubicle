PRAMAAN_HOST=127.0.0.1
PRAMAAN_PORT=8000
PRAMAAN_DB_PATH=data/pramaan.db
# Requires a SQLCipher-capable driver. Startup fails closed when a key is set
# but the active SQLite driver has no cipher support.
# PRAMAAN_DB_KEY=load-this-from-a-local-secret-store
PRAMAAN_OLLAMA_URL=http://127.0.0.1:11434
PRAMAAN_OLLAMA_MODEL=gemma3:4b
PRAMAAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000/api


